# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Concurrency Limits
MAX_CONCURRENT_SCANS=2
MAX_TARGETS_PER_SCAN=16
SCAN_TIMEOUT_SECONDS=900
GLOBAL_RATE_LIMIT=10

# Optional Target Allowlist (comma-separated CIDR/IP list, e.g., 10.0.0.0/8,192.168.0.0/16,127.0.0.1)
# When set, targets outside these ranges are strictly rejected by the backend
ALLOWED_TARGET_RANGES=

# Optional NVD API Key for CVE enrichment
NVD_API_KEY=

# Optional Webhook URL for scan completion notifications (Slack, Discord, custom webhook)
NOTIFICATION_WEBHOOK_URL=

# AI Studio runtime vars
GEMINI_API_KEY=
APP_URL=
